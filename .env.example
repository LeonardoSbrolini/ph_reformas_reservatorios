# Variáveis de ambiente do site — copie para .env.local e preencha os valores.

# Google Search Console — verificação de propriedade do site.
# No Search Console, escolha "Tag HTML" e copie APENAS o valor do content="...".
# Renderiza <meta name="google-site-verification" content="..."> no <head>.
# Sempre presente (não usa cookies / não depende de consentimento).
GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 — ID de medição (ex.: G-XXXXXXXXXX).
# O gtag só é carregado APÓS o visitante aceitar os cookies.
NEXT_PUBLIC_GA_ID=
